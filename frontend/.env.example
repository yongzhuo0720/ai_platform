# ============================================================
# 本地开发配置模板
#
# 用法：复制本文件为 .env.local，填入你自己的值。
#   .env.local 已被 .gitignore 忽略，不会提交到仓库。
#   .env.example 本身只放占位符，永远不要在里面写真密钥。
#
# 生效规则（默认网关模式）：
#   浏览器只请求 /ai/api/aiGateway/**，Dify 地址与密钥由后端提供：
#     1) 数据库 difyconfigbean（后台「Dify 配置管理」页面维护）
#     2) 后端环境变量 DIFY_*
#   自定义助手（名称 + 提示词）保存在 assistantbean，随对话请求走同一网关。
#   下方 VITE_DIFY_* 仅在直连模式下生效。
#
# 直连模式（排障 / 兼容旧行为）：
#   VITE_AI_GATEWAY=0 时恢复「浏览器直连 Dify」，
#   此时密钥会随请求下发到浏览器，且没有限流 / 配额 / 审计。
# ============================================================

# ---------- 网关开关 ----------
# 留空或填 1：走服务端 AI 网关（推荐）
# 填 0：浏览器直连 Dify（使用下方 VITE_DIFY_*）
VITE_AI_GATEWAY=

# ---------- 以下变量仅直连模式（VITE_AI_GATEWAY=0）生效 ----------

# 通用兜底（三个模块都没单独配时使用这一组）
# Dify 云端是 https://api.dify.ai/v1 ，自建 docker 通常是 http://localhost/v1
VITE_DIFY_API_URL=
VITE_DIFY_API_KEY=

# ---------- 问答聊天对话模块 ----------
# Dify 里某个「聊天助手 / Agent / 工作流」应用的 API Key（app- 开头）
VITE_DIFY_CHAT_URL=
VITE_DIFY_CHAT_KEY=

# ---------- 知识库对话 / 工作流模块 ----------
VITE_DIFY_KB_CHAT_URL=
VITE_DIFY_KB_CHAT_KEY=

# ---------- 知识库文件模块 ----------
# 注意：这一组要的是 dataset 级密钥（dataset- 开头），
# 在 Dify「知识库 → 设置 → API」里生成，和上面 app- 开头的应用密钥不是一回事。
VITE_DIFY_KB_FILE_URL=
VITE_DIFY_KB_FILE_KEY=
